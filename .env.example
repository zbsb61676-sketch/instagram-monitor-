# Server configuration
PORT=3000
HOST=0.0.0.0

# Telegram Bot Alerts (optional in .env, can also be set directly in the Web UI)
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Discord Webhook Alerts (optional in .env, can also be set directly in the Web UI)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Proxy Settings (optional, recommended when deployed on free cloud hosts like Render)
# PROXY_URL=http://user:password@proxy-host:port

# Instagram Session Cookie (optional, for bypassing all rate limits)
# IG_SESSION_COOKIE=your_sessionid_cookie_value
