# Server configuration
PORT=3000
HOST=0.0.0.0

# Telegram Bot Alerts (optional in .env, can also be set directly in the Web UI)
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Discord Webhook Alerts (optional in .env, can also be set directly in the Web UI)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Proxy Settings (optional, recommended when deployed on free cloud hosts like Render)
# PROXY_URL=http://user:password@proxy-host:port

# Instagram Session Cookie (optional, for bypassing all rate limits)
# IG_SESSION_COOKIE=your_sessionid_cookie_value

# Optional Dashboard & API Protection (leave blank for open local access)
# DASHBOARD_PASSWORD=choose_a_strong_password

# Robustness & Resource Limits (optional tuning)
# MAX_CONCURRENT_CHECKS=3
# DOWNLOAD_CONCURRENCY=6
# METADATA_CONCURRENCY=3
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_COOLDOWN_SEC=60
# ALERT_MAX_RETRIES=3
# MAX_STORAGE_MB=500
# MAX_CACHE_AGE_MIN=30
